  "constraints": [
    {
      "name": "nexus_company_entitlements_company_id_fkey",
      "table": "nexus_company_entitlements",
      "definition": "FOREIGN KEY (company_id) REFERENCES nexus_companies(id) ON DELETE CASCADE"
    },
    {
      "name": "nexus_company_entitlements_company_id_offering_code_key",
      "table": "nexus_company_entitlements",
      "definition": "UNIQUE (company_id, offering_code)"
    },
    {
      "name": "nexus_company_entitlements_created_by_fkey",
      "table": "nexus_company_entitlements",
      "definition": "FOREIGN KEY (created_by) REFERENCES auth.users(id) ON DELETE SET NULL"
    },
    {
      "name": "nexus_company_entitlements_offering_code_fkey",
      "table": "nexus_company_entitlements",
      "definition": "FOREIGN KEY (offering_code) REFERENCES nexus_commercial_offerings(code) ON DELETE RESTRICT"
    },
    {
      "name": "nexus_company_entitlements_pkey",
      "table": "nexus_company_entitlements",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "nexus_company_entitlements_scope_check",
      "table": "nexus_company_entitlements",
      "definition": "CHECK ((jsonb_typeof(scope) = 'object'::text))"
    },
    {
      "name": "nexus_company_entitlements_source_check",
      "table": "nexus_company_entitlements",
      "definition": "CHECK ((source = ANY (ARRAY['manual'::text, 'contract'::text, 'purchase'::text, 'legacy'::text, 'diagnosis_delivery'::text])))"
    },
    {
      "name": "nexus_company_entitlements_status_check",
      "table": "nexus_company_entitlements",
      "definition": "CHECK ((status = ANY (ARRAY['active'::text, 'pending'::text, 'expired'::text, 'cancelled'::text])))"
    },
    {
      "name": "nexus_task_comments_author_id_fkey",
      "table": "nexus_task_comments",
      "definition": "FOREIGN KEY (author_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "nexus_task_comments_body_check",
      "table": "nexus_task_comments",
      "definition": "CHECK (((char_length(TRIM(BOTH FROM body)) >= 1) AND (char_length(TRIM(BOTH FROM body)) <= 4000)))"
    },
    {
      "name": "nexus_task_comments_company_id_fkey",
      "table": "nexus_task_comments",
      "definition": "FOREIGN KEY (company_id) REFERENCES nexus_companies(id) ON DELETE CASCADE"
    },
